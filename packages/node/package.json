{
  "name": "plasgos-crm-sdk",
  "version": "1.0.1",
  "description": "Official Node.js / TypeScript SDK for the Plasgos CRM Api Integration API.",
  "keywords": [
    "plasgos",
    "crm",
    "whatsapp",
    "waba",
    "sdk",
    "api"
  ],
  "license": "MIT",
  "author": "Plasgos",
  "homepage": "https://github.com/plasgos/plasgos-crm-sdk/tree/main/packages/node",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/plasgos/plasgos-crm-sdk.git",
    "directory": "packages/node"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./webhooks": {
      "types": "./dist/webhooks/index.d.ts",
      "import": "./dist/webhooks/index.js",
      "require": "./dist/webhooks/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  }
}
