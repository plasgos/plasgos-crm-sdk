{
  "name": "plasgos/crm-sdk",
  "description": "Official PHP SDK for the Plasgos CRM Api Integration API.",
  "type": "library",
  "license": "MIT",
  "keywords": ["plasgos", "crm", "whatsapp", "waba", "sdk", "api"],
  "homepage": "https://github.com/plasgos/plasgos-crm-sdk/tree/main/packages/php",
  "authors": [{ "name": "Plasgos" }],
  "require": {
    "php": ">=8.1",
    "ext-json": "*",
    "ext-hash": "*",
    "psr/http-client": "^1.0",
    "psr/http-factory": "^1.0",
    "psr/http-message": "^1.1 || ^2.0",
    "guzzlehttp/guzzle": "^7.5"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5"
  },
  "autoload": {
    "psr-4": { "Plasgos\\CrmSdk\\": "src/" },
    "files": ["src/Exception/Exceptions.php"]
  },
  "autoload-dev": {
    "psr-4": { "Plasgos\\CrmSdk\\Tests\\": "tests/" }
  },
  "scripts": {
    "test": "phpunit"
  },
  "config": {
    "sort-packages": true
  },
  "minimum-stability": "stable"
}
